NEXT_PUBLIC_SITE_URL=https://gulshanblogs.vercel.app

# Private Author Studio server-only configuration
AUTHOR_STUDIO_USERNAME=gulshanverse
AUTHOR_STUDIO_PASSWORD=replace-with-a-strong-private-password
AUTHOR_STUDIO_SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_REPOSITORY=gulshanverse/my-tech-blog
GITHUB_BRANCH=main
GITHUB_TOKEN=replace-with-a-server-only-github-token

# Optional private Search Console Analytics Center configuration
# Ownership verification is configured in app/layout.tsx; it does not grant API access.
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://gulshanblogs.vercel.app/
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=replace-with-server-only-google-oauth-client-secret
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=replace-with-server-only-google-oauth-refresh-token
